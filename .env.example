# Copy this file to .env (the app does not read .env.example).
# LLM — OpenAI-compatible. `auto` picks DeepSeek if DEEPSEEK_API_KEY is set.
OPTION_DESK_LLM_PROVIDER=deepseek
OPTION_DESK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Generic key (used if the vendor-specific one is empty).
# OPTION_DESK_API_KEY=

# Any other OpenAI-compatible server (vLLM, LM Studio, relay, Qwen, …):
# OPTION_DESK_LLM_PROVIDER=openai_compatible
# OPTION_DESK_BACKEND_URL=http://localhost:8000/v1
# OPTION_DESK_MODEL=your-model-id
# OPTION_DESK_API_KEY=not-needed-for-local

# OpenAI:
# OPTION_DESK_LLM_PROVIDER=openai
# OPTION_DESK_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Optional: better web search than DuckDuckGo.
TAVILY_API_KEY=

# Account cash used for CSP assignment coverage (USD).
OPTION_DESK_CASH=55000

# Comma-separated default universe.
OPTION_DESK_TICKERS=NVDA,MSFT

# Terminal, report, and each web run: en or zh.
# The web chrome follows the in-page EN/中文 switch; each analysis sends that language.
# OPTION_DESK_OUTPUT_LANGUAGE=zh

# OPTION_DESK_WEB_HOST=0.0.0.0
# OPTION_DESK_WEB_PORT=8000
