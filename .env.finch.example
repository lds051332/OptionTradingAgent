# Finch Agent Market runtime (python -m option_desk.finch).
# Copy to .env.finch next to .env. Never commit the real file.
# Key ID and secrets come from the Finch Provider workspace credential setup
# for this service version (wireProtocol finch_v2).
FINCH_KEY_ID=
FINCH_REQUEST_SECRET=
FINCH_CALLBACK_SECRET=

# Separate LLM key for this channel. Overrides DEEPSEEK_API_KEY from .env
# for the Finch process only; the web desk keeps its own key.
# DEEPSEEK_API_KEY=

# Loopback only. Nginx proxies https://option.xdashan.top/finch/ here.
# FINCH_HOST=127.0.0.1
# FINCH_PORT=8010

# Real analyses per server-local day. 0 means unlimited.
# FINCH_DAILY_LIMIT=100
# FINCH_MAX_CONCURRENCY=1
# FINCH_MAX_QUEUE=5
# FINCH_MAX_TICKERS=3

# Keep at or below the Offer's input-round limit.
# FINCH_MAX_INPUT_ROUNDS=2

# FINCH_POLL_AFTER_MS=3000
# FINCH_DB_PATH=/home/ubuntu/.option_desk/finch.sqlite3
